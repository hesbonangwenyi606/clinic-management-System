generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  SUPER_ADMIN
  CLINIC_ADMIN
  RECEPTIONIST
  CASHIER
  ATTENDANT
  PHARMACIST
  LAB_TECHNICIAN
  CLINICIAN_1
  CLINICIAN_2
  CLINICIAN_3
  RECOVERY_NURSE
  CATERING_STAFF
  ACCOUNTANT
  PROCUREMENT_OFFICER
}

enum VisitType {
  OUTPATIENT
  INPATIENT
}

enum VisitStatus {
  REGISTERED
  WAITING
  IN_PROGRESS
  REFERRED
  ADMITTED
  UNDER_OBSERVATION
  COMPLETED
  DISCHARGED
  CANCELLED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  NOT_SPECIFIED
}

model User {
  expensesRecorded Expense[] @relation("Expense_recordedBy")
  appointmentsCreated Appointment[] @relation("Appointment_createdBy")
  paymentsRecorded Payment[] @relation("Payment_recordedBy")
  invoicesCreated Invoice[] @relation("Invoice_createdBy")
  prescriptionsDispensed Prescription[] @relation("Prescription_dispensedBy")
  prescriptionsAuthored Prescription[] @relation("Prescription_prescribedBy")
  movementsAuthored StockMovement[] @relation("StockMovement_recordedBy")
  labsResulted LabOrder[] @relation("LabOrder_resultedBy")
  labsRequested LabOrder[] @relation("LabOrder_requestedBy")
  careAuthored CareEntry[] @relation("CareEntry_recordedBy")
  id           String       @id @default(uuid()) @db.Uuid
  patientId String? @unique @db.Uuid
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  email        String       @unique
  sessionVersion Int @default(0)
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdVisits Visit[]     @relation("VisitCreator")
  auditEntries AuditLog[]
  workflowEvents WorkflowEvent[] @relation("WorkflowChanger")
  admissions Admission[]
  admissionEvents AdmissionEvent[]
  amendments RecordAmendment[]
  reversals PaymentReversal[]
  passwordRecovery PasswordRecovery?
}

model PasswordRecovery {
  userId         String   @id @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash       String
  sessionVersion Int
  expiresAt      DateTime
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
}

model Patient {
  id              String   @id @default(uuid()) @db.Uuid
  patientNumber   String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender  @default(NOT_SPECIFIED)
  phone           String?
  email           String?
  address         String?
  emergencyContact String?
  nextOfKin       String?
  allergies       String?
  medicalAlerts   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  visits          Visit[]
  archivedAt DateTime?
  portalAccount User?
  appointments Appointment[]
  @@index([archivedAt, createdAt])
}

model Visit {
  id              String      @id @default(uuid()) @db.Uuid
  visitNumber     String      @unique
  patientId       String      @db.Uuid
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  type            VisitType
  status          VisitStatus @default(REGISTERED)
  reason          String
  currentDepartment String?
  arrivedAt       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String      @db.Uuid
  createdBy       User        @relation("VisitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  workflowEvents  WorkflowEvent[]
  careEntries CareEntry[]
  labOrders LabOrder[]
  invoices Invoice[]
  prescriptions Prescription[]
  admission Admission?

  @@index([patientId, createdAt])
  @@index([status, arrivedAt])
}

model CareEntry {
  author User @relation("CareEntry_recordedBy", fields:[recordedBy], references:[id], onDelete:Restrict)
  amendments RecordAmendment[]
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  department String
  summary String
  details Json
  recordedBy String @db.Uuid
  createdAt DateTime @default(now())
  @@index([visitId, createdAt])
  @@index([department, createdAt])
  @@index([recordedBy])
}

model LabOrder {
  resultAuthor User? @relation("LabOrder_resultedBy", fields:[resultedBy], references:[id], onDelete:Restrict)
  requester User @relation("LabOrder_requestedBy", fields:[requestedBy], references:[id], onDelete:Restrict)
  amendments RecordAmendment[]
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  testName String
  status String @default("REQUESTED")
  result String?
  requestedBy String @db.Uuid
  resultedBy String? @db.Uuid
  resultedAt DateTime?
  createdAt DateTime @default(now())
  @@index([visitId, createdAt])
  @@index([status, createdAt])
  @@index([requestedBy])
  @@index([resultedBy])
}

model StockItem {
  id String @id @default(uuid()) @db.Uuid
  name String
  batch String
  expiresAt DateTime
  quantity Int @default(0)
  reorderLevel Int @default(10)
  movements StockMovement[]
  prescriptions Prescription[]
  @@unique([name, batch])
}

model StockMovement {
  author User @relation("StockMovement_recordedBy", fields:[recordedBy], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  stockItemId String @db.Uuid
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity Int
  reason String
  recordedBy String @db.Uuid
  createdAt DateTime @default(now())
  @@index([stockItemId, createdAt])
  @@index([recordedBy])
}

model Prescription {
  dispenser User? @relation("Prescription_dispensedBy", fields:[dispensedBy], references:[id], onDelete:Restrict)
  prescriber User @relation("Prescription_prescribedBy", fields:[prescribedBy], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  stockItemId String @db.Uuid
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity Int
  instructions String
  prescribedBy String @db.Uuid
  dispensedBy String? @db.Uuid
  dispensedAt DateTime?
  createdAt DateTime @default(now())
  @@index([visitId, createdAt])
  @@index([stockItemId])
  @@index([dispensedAt, createdAt])
  @@index([prescribedBy])
  @@index([dispensedBy])
}

model Invoice {
  creator User @relation("Invoice_createdBy", fields:[createdBy], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  visitId String @db.Uuid
  visit Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  description String
  amountCents Int
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  payments Payment[]
  mpesaAttempt MpesaAttempt?
  @@index([visitId, createdAt])
  @@index([createdBy])
}

model MpesaAttempt {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String? @unique @db.Uuid
  invoice Invoice? @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
  pendingPatient Json?
  createdById String @db.Uuid
  phone String
  amount Int
  tokenHash String @unique
  checkoutId String? @unique
  status String @default("INITIATING")
  message String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  recorder User @relation("Payment_recordedBy", fields:[recordedBy], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents Int
  method String
  reference String @unique
  recordedBy String @db.Uuid
  createdAt DateTime @default(now())
  reversal PaymentReversal?
  @@index([invoiceId])
  @@index([createdAt])
  @@index([recordedBy])
}

model Appointment {
  creator User @relation("Appointment_createdBy", fields:[createdBy], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  scheduledAt DateTime
  reason String
  status String @default("BOOKED")
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  @@index([scheduledAt, status])
  @@index([patientId])
  @@index([createdBy])
}

model WorkflowEvent {
  id          String      @id @default(uuid()) @db.Uuid
  visitId     String      @db.Uuid
  visit       Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fromStatus  VisitStatus?
  toStatus    VisitStatus
  note        String?
  changedById String      @db.Uuid
  changedBy   User        @relation("WorkflowChanger", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime    @default(now())

  @@index([visitId, changedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model Expense {
  recorder User @relation("Expense_recordedBy", fields:[recordedBy], references:[id], onDelete:Restrict)
 id String @id @default(uuid()) @db.Uuid
 description String
 category String
 amountCents Int
 reference String @unique
 incurredAt DateTime
 recordedBy String @db.Uuid
 createdAt DateTime @default(now())
  @@index([incurredAt])
  @@index([recordedBy])
}

model Bed {
  id String @id @default(uuid()) @db.Uuid
  ward String
  name String
  active Boolean @default(true)
  admissions Admission[]
  @@unique([ward, name])
}

model Admission {
  id String @id @default(uuid()) @db.Uuid
  visitId String @unique @db.Uuid
  visit Visit @relation(fields:[visitId],references:[id],onDelete:Restrict)
  bedId String @db.Uuid
  bed Bed @relation(fields:[bedId],references:[id],onDelete:Restrict)
  clinicianId String @db.Uuid
  clinician User @relation(fields:[clinicianId],references:[id],onDelete:Restrict)
  admittedAt DateTime @default(now())
  dischargedAt DateTime?
  dischargeSummary String?
  events AdmissionEvent[]
  @@index([bedId, dischargedAt])
}

model AdmissionEvent {
  id String @id @default(uuid()) @db.Uuid
  admissionId String @db.Uuid
  admission Admission @relation(fields:[admissionId],references:[id],onDelete:Restrict)
  action String
  details String
  recordedBy String @db.Uuid
  actor User @relation(fields:[recordedBy],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@index([admissionId, createdAt])
}

model RecordAmendment {
  id String @id @default(uuid()) @db.Uuid
  careEntryId String? @db.Uuid
  careEntry CareEntry? @relation(fields:[careEntryId],references:[id],onDelete:Restrict)
  labOrderId String? @db.Uuid
  labOrder LabOrder? @relation(fields:[labOrderId],references:[id],onDelete:Restrict)
  text String
  reason String
  recordedBy String @db.Uuid
  actor User @relation(fields:[recordedBy],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@index([careEntryId, createdAt])
  @@index([labOrderId, createdAt])
}

model PaymentReversal {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid
  payment Payment @relation(fields:[paymentId],references:[id],onDelete:Restrict)
  reason String
  recordedBy String @db.Uuid
  actor User @relation(fields:[recordedBy],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@index([createdAt])
}
