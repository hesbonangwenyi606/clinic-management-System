DATABASE_URL="postgresql://cms:cms-local-password@localhost:5432/clinic_management?schema=public"
JWT_SECRET=""
CMS_WEB_ORIGIN="http://localhost:3000"
CMS_API_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
CMS_BOOTSTRAP_ADMIN_EMAIL="clinic.admin@example.com"
CMS_BOOTSTRAP_ADMIN_PASSWORD=""

# Password recovery email (Gmail requires a Google app password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
