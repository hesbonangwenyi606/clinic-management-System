# M-Pesa sandbox only. Set callback URL to the public HTTPS base ending in /api/v1/mpesa/callback.
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""

# Used by compose.yaml. Use a strong password containing URL-safe characters.
POSTGRES_PASSWORD=""
